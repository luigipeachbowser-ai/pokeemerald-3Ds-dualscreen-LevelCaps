+#ifdef PLATFORM_3DS
+/* Level caps (OPTIONS, ENHANCEMENTS, "level_caps"): the highest level a
+ * Pokémon of the player's reaches, by the badges won - each the level of
+ * that Gym Leader's ace, the eighth the Champion's. Beating the Champion
+ * lifts the cap. */
+static const u8 sLevelCaps[NUM_BADGES + 1] =
+{
+    15, // no badge: Roxanne's
+    19, // Brawly
+    24, // Wattson
+    29, // Flannery
+    32, // Norman
+    34, // Winona
+    43, // Tate and Liza
+    47, // Juan
+    58, // eight badges: Wallace's
+};
+
+u8 GetLevelCap(void)
+{
+    u8 badges = 0;
+    s32 i;
+
+    if (!CtrExtras_Get("level_caps") || FlagGet(FLAG_SYS_GAME_CLEAR))
+        return MAX_LEVEL;
+    for (i = 0; i < NUM_BADGES; i++)
+        if (FlagGet(FLAG_BADGE01_GET + i))
+            badges++;
+    return sLevelCaps[badges];
+}
+
+/* The EXP a mon may still gain under the level cap: 0 at it, at most the
+ * points to the cap's level, so a level-up ends exactly there. */
+u32 ApplyLevelCapToExp(struct Pokemon *mon, u32 exp)
+{
+    u8 cap = GetLevelCap();
+    u16 species;
+    u32 currExp;
+    u32 capExp;
+
+    if (exp == 0 || GetMonData(mon, MON_DATA_LEVEL) >= cap)
+        return 0;
+    species = GetMonData(mon, MON_DATA_SPECIES);
+    currExp = GetMonData(mon, MON_DATA_EXP);
+    capExp = gExperienceTables[gSpeciesInfo[species].growthRate][cap];
+    if (currExp >= capExp)
+        return 0;
+    if (exp > capExp - currExp)
+        return capExp - currExp;
+    return exp;
+}
+#endif
+
 bool8 TryIncrementMonLevel(struct Pokemon *mon)
 {
     u16 species = GetMonData(mon, MON_DATA_SPECIES, 0);
